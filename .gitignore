# ==== Global-gitignore overrides ====
# Our user-global ~/.config/git/ignore excludes design-docs/, CLAUDE.md, and .claude/.
# This repo tracks them, so override.
!design-docs
!CLAUDE.md
!.claude
!.claude/rules
!.claude/skills
!.claude/settings.json

# Per-session harness state inside .claude/ — never committed.
.claude/scheduled_tasks.lock

# ==== Build outputs ====
# WebUI SPA bundled output (built by `mise //admin:build`).
cafleet/src/cafleet/webui/

# ==== Toolchain caches ====
/node_modules/
admin/node_modules/
/.venv/
.vite/
__pycache__/
*.pyc

# ==== Generated content ====
# Research report output — one folder per topic, generated by /research-report.
/researches/

# ==== CAFleet runtime artifacts at the repo root ====
# Anchor file written by `cafleet base-dir record` (design 0000055).
/.cafleet-base-dir.json

# Legacy spawn-prompt audit directory at the repo root. Audit files are now
# written under per-task folders (`researches/<slug>/prompts/`,
# `design-docs/<NNNNNNN>-<slug>/prompts/`); this entry keeps any straggler
# writes during the rollout out of version control.
/prompts/

# Spawn-prompt audit re-renders written by the Director when ${BASE} = repo root
# (design 0000053: ${BASE}/<role>.md — one per spawned member-role per invocation).
/drafter.md
/drafter-resume.md
/reviewer.md
/manager.md
/scout.md
/researcher.md
/presentation.md
/transcript.md
/visual-reviewer.md
/programmer.md
/tester.md
/verifier.md
/analyzer.md

# Clarification-phase scratch (Director ↔ Drafter file-based relay when broker
# truncation cuts off long question/answer payloads).
/drafter-questions.md
/director-answers.md
