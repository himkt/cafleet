# ==== Global-gitignore overrides ====
# Our user-global ~/.config/git/ignore excludes design-docs/, CLAUDE.md, and .claude/.
# This repo tracks them, so override.
!design-docs
!CLAUDE.md
!.claude
!.claude/rules
!.claude/skills
!.claude/settings.json

# Per-session harness state inside .claude/ — never committed.
.claude/scheduled_tasks.lock

# ==== Build outputs ====
# WebUI SPA bundled output (built by `mise //admin:build`).
cafleet/src/cafleet/webui/

# Zensical documentation site built by `mise //:docs-build`. Leading slash so
# the pattern matches the repo-root artifact only, not any future nested `site/`.
/site/

# ==== Toolchain caches ====
/node_modules/
admin/node_modules/
/.venv/
.vite/
__pycache__/
*.pyc

# ==== Generated content ====
# Research report output — one folder per topic, generated by /research-report.
/researches/

# ==== CAFleet runtime artifacts at the repo root ====
# Anchor file written by `cafleet base-dir record`.
# Also matches per-task anchors written by the positional `cafleet base-dir resolve <task-name>`
# branch inside <repo>/researches/<slug>/ and <repo>/design-docs/<NNNNNNN>-<slug>/.
.cafleet-base-dir.json

# Stray spawn-prompt audit writes at the repo root; the canonical location is
# per-task `prompts/` folders (`researches/<slug>/prompts/`,
# `design-docs/<NNNNNNN>-<slug>/prompts/`).
/prompts/

# Spawn-prompt audit re-renders written by the Director when ${BASE} = repo root
# (${BASE}/<role>.md — one per spawned member-role per invocation).
/drafter.md
/drafter-resume.md
/reviewer.md
/manager.md
/scout.md
/researcher.md
/presentation.md
/transcript.md
/visual-reviewer.md
/programmer.md
/tester.md
/verifier.md
/analyzer.md

# Clarification-phase scratch (Director ↔ Drafter file-based relay when broker
# truncation cuts off long question/answer payloads).
/drafter-questions.md
/director-answers.md
